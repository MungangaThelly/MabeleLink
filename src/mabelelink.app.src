{application, mabelelink,
 [{description, "MabeleLink agricultural coordination MVP"},
  {vsn, "0.1.0"},
  {registered, [mabelelink_sup, mabelelink_listings, mabelelink_http]},
  {mod, {mabelelink_app, []}},
  {applications, [kernel, stdlib, cowboy, jsx]},
  {env, [{http_port, 8080}]},
  {modules, [mabelelink_app, mabelelink_sup, mabelelink_listings,
             mabelelink_auth, mabelelink_http, mabelelink_http_handler]}]}.
